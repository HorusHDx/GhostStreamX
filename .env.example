# Copia este archivo a `.env` y completa los valores.

# Obligatoria: API key de TMDB (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=pon_tu_key_aqui

# Opcional: base de nsrplay (solo cámbiala si cambia el dominio)
# NSRPLAY_BASE=https://nsrplay.space

# Servidor S2 (NasriPlay) — OBLIGATORIA para S2 desde nsrplay v1.3.5
# (todos los endpoints de reproducción exigen key). SOLO server-side.
# Generala en tu panel, ponela en `.env` local y en Vercel → Env Vars.
# Nunca al front, nunca al repo (si se filtra, el consumo lo pagás vos).
# NSRPLAY_API_KEY=pon_tu_key_aqui

# Puerto del backend en local (no toques para dev normal)
# PORT=3001
