# Copia este archivo a `.env` y completa los valores.

# Obligatoria: API key de TMDB (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=pon_tu_key_aqui

# Opcional — proxy de scraping para P1/P2/P3 (ver server/scrapeFetch.js):
# SCRAPER_PROXY_URL=https://work-pelisplus.TU.workers.dev
# SCRAPER_PROXY_TOKEN=token_del_worker

# Opcional — worker dedicado de la fuente Cuevana3 (P4, anti-ban):
# CUEVANA_PROXY_URL=https://work-cuevana.TU.workers.dev
# CUEVANA_PROXY_TOKEN=token_del_worker_cuevana

# Obligatoria solo si querés la fuente NasriPlay (P5) — API de terceros
# aprobada. La key se genera en el panel de NasriPlay y solo vive en Vercel
# (nunca en este repo: es público):
# NSRPLAY_API_KEY=pon_tu_key_aqui

# Puerto del backend en local (no toques para dev normal)
# PORT=3001